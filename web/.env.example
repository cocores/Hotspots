# Copy to .env.local and fill in from the same Firebase project used by
# ios/ (Firebase console → Project settings → General → Your apps → Add
# app → Web). See web/README.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
